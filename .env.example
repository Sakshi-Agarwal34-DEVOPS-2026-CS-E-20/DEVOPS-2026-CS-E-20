# LUMEN LUXE — Environment Configuration

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Note: If your password contains special characters like '@', replace '@' with '%40'.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/lumen-luxe?retryWrites=true&w=majority

# Optional Admin Security Key for protected administrative endpoints
ADMIN_KEY=YOUR_LONG_RANDOM_SECRET
