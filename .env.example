# LUMEN LUXE — Environment Configuration

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/lumen-luxe?retryWrites=true&w=majority
# If omitted, the server automatically operates in local JSON file storage mode.
MONGODB_URI=

# Optional Admin Security Key for protected administrative endpoints
ADMIN_KEY=
